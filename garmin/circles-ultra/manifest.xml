<?xml version="1.0"?>
<!--
  Circles Ultra - Connect IQ watch face
  Reference device: Forerunner 165 / 165 Music (390x390 AMOLED, round)

  minApiLevel is kept at 3.2.0 on purpose so the same binary covers older MIP
  Forerunners/fenix as well. Everything newer (body battery, burn-in protection,
  weather) is feature-detected at runtime with `has` checks.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="CirclesUltraApp"
        id="a4ddffe7c9664152817a646b26688442"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0"
        name="@Strings.AppName"
        type="watchface">

        <iq:products>
            <!-- ============ Reference target ============ -->
            <iq:product id="fr165"/>
            <iq:product id="fr165m"/>

            <!-- ============ Forerunner ============ -->
            <iq:product id="fr55"/>
            <iq:product id="fr245"/>
            <iq:product id="fr245m"/>
            <iq:product id="fr255"/>
            <iq:product id="fr255s"/>
            <iq:product id="fr255m"/>
            <iq:product id="fr255sm"/>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
            <iq:product id="fr745"/>
            <iq:product id="fr945"/>
            <iq:product id="fr945lte"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>

            <!-- ============ Venu / Vivoactive ============ -->
            <iq:product id="venu"/>
            <iq:product id="venu2"/>
            <iq:product id="venu2s"/>
            <iq:product id="venu2plus"/>
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
            <iq:product id="venusq"/>
            <iq:product id="venusqm"/>
            <iq:product id="venusq2"/>
            <iq:product id="venusq2m"/>
            <iq:product id="vivoactive3"/>
            <iq:product id="vivoactive3m"/>
            <iq:product id="vivoactive4"/>
            <iq:product id="vivoactive4s"/>
            <iq:product id="vivoactive5"/>

            <!-- ============ fenix / epix ============ -->
            <iq:product id="fenix6"/>
            <iq:product id="fenix6s"/>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix6spro"/>
            <iq:product id="fenix6xpro"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
        </iq:products>

        <iq:permissions>
            <!-- Body Battery / Stress spheres. Nothing else is requested:
                 no Positioning, no Background, no Communications. -->
            <iq:uses-permission id="SensorHistory"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>spa</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
